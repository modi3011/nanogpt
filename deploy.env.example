# Copy this file to deploy.env (same folder as deploy.sh) and fill in your
# values. deploy.env holds HF_TOKEN, so make sure it's git-ignored.

# ---- Azure resource naming (used by `provision` and `deploy`) ----
RESOURCE_GROUP="nanogpt-rebuilt"
LOCATION="australiaeast"
ACR_NAME="nanogptacr"                  # must be globally unique, lowercase alphanumeric only
ACR_SKU="Basic"
PLAN_NAME="nanogpt-plan"
PLAN_SKU="B1"                          # Basic tier — plenty for CPU inference on a ~49M-param model
WEBAPP_NAME="nanogpt-rebuilt"          # must be globally unique -> becomes <name>.azurewebsites.net
REPO_NAME="nanogpt"                    # ACR repository name for the image

# ---- Source ----
SRC_DIR="/path/to/nanogpt-rebuilt"     # repo ROOT (parent of docker/) — matches `context: ..` in compose
DOCKERFILE_PATH="docker/Dockerfile.prod"

# ---- App runtime env vars (mirrors docker-compose.yml) ----
HF_TOKEN="hf_xxx"
HF_REPO_STORIES="your-hf-username/nanogpt-stories"
HF_REPO_CODE="your-hf-username/nanogpt-code"
STORIES_CKPT_PATH="checkpoints/stories/ckpt.pt"
CODE_CKPT_PATH="checkpoints/code/ckpt.pt"

# ---- Container startup ----
# Seconds Azure will wait for the container to respond before considering the
# deploy failed. Checkpoint downloads at boot can take a while on first run —
# bump this if you see startup timeouts in `az webapp log tail`.
CONTAINER_START_TIME_LIMIT=600
